    "pnx" : {
      "display" : {
        "source" : [ "Alma" ],
        "type" : [ "Printed_Book" ],
        "language" : [ "eng" ],
        "title" : [ "Chemical engineering : a new introduction " ],
        "format" : [ "xi, 265 p. : ill. ; 27 cm. " ],
        "identifier" : [ "$$CLC$$V  2011012921 ;$$CISBN$$V9781107011892 (hardback) :;$$CISBN$$V9781107669376 (pbk.) " ],
        "creationdate" : [ "2012. " ],
        "creator" : [ "Denn, Morton M., 1939- $$QDenn, Morton M." ],
        "publisher" : [ "Cambridge ; New York : Cambridge University Press" ],
        "description" : [ "\"Chemical Engineering: An Introduction is designed to enable the student to explore a broad range of activities in which a modern cheical engineer might be involved by focusing on mass and energy balances in liquid-phase processes. Thus, in one semester, the student addresses such problems as the design of a feedback level controller, membrane separation, and hemodialysis, optimal design of a process with chemical reaction and separation, washout in a bioreactor, kinetic and mass transfer limits in a two-phase reactor, and the use of the membrane reactor to overcome equilibrium limits on conversion. Mathematics is employed as a language, but the mathematics is at the most elementary level and serves to reinforce what the student has already studied; nothing more than basic differential and integral calculus is required, together with elementary chemistry. Students using this text will understand what they can expect to do as chemical engineering graduates, and they will appreciate why they need the courses that follow in the core curriculum\"-- Provided by publisher. " ],
        "mms" : [ "991002557509703286" ],
