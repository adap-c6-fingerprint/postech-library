    "adaptor" : "Local Search Engine",
    "@id" : "https://ap01.alma.exlibrisgroup.com/primaws/rest/pub/pnxs/L/991000690009703286",
    "pnx" : {
      "display" : {
        "source" : [ "Alma" ],
        "type" : [ "Printed_Book" ],
        "language" : [ "kor" ],
        "title" : [ "(핵심)C/C++ 프로그래밍 " ],
        "format" : [ "516 p. : 삽화 ; 26 cm" ],
        "identifier" : [ "$$CISBN$$V9788956660820" ],
        "creationdate" : [ "2007" ],
        "creator" : [ "홍성식$$Q홍성식" ],
        "publisher" : [ "서울 : 정일" ],
        "description" : [ "이 책의 특징. 1) 각 부와 각 장별로 C 및 C++ 언어의 주요 학습내용과 함께 다양한 프로그램을 개발해 두었고 또한 프로그램의 실행결과가 제시되어 있습니다. 2) 객체지향 프로그래밍 언어로는 JAVA나 Visual C++ 등이 있으나 최근에도 지속적으로 확장이 되고 있고 폭넓게 사용되고 있는 C 및 C++를 통해 기능을 쉽고도 빠르게 이해할 수 있게 하고자 노력하였습니다. 3) C++는 윈도우즈 프로그래밍에 적합한 언어이지만 윈도우즈 프로그램을 작성하고자 하면 수많은   코드가 필요하고 규모가 커져서 매우 복잡하므로, C++의 특징과 원리 및 OOP 개념에 입각한 프로그래밍을 효율적으로 학습하기 위하여 콘솔 프로그램으로 실행하였습니다." ],
        "mms" : [ "991000690009703286" ],
        "contributor" : [ "이송근$$Q이송근" ],
        "addtitle" : [ "C/C++ 프로그래밍", "Essential C & C++ Programming" ],
        "place" : [ "서울 :" ],
        "version" : [ "0" ],
        "subject" : [ "C C++ 프로그래밍" ]
      },
