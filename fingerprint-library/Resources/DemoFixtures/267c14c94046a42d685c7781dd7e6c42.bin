        "type" : [ "Printed_Book" ],
        "language" : [ "kor" ],
        "title" : [ "모던 리코딩 테크닉 " ],
        "format" : [ "774 p. : 삽화 ; 24 cm", "Huber, David Miles", "Runstein, Robert E.", "Modern Recording Techniques" ],
        "identifier" : [ "$$CISBN$$V9788984997356" ],
        "creationdate" : [ "2008" ],
        "publisher" : [ "서울 : 커뮤니케이션북스" ],
        "description" : [ "음향업계 종사자들이 가장 많이 찾는 음향학의 바이블. 음향 제작에 필요한 녹음, 믹싱, 마스터링 작업의 구체적인 방법을 소개한다. 음향학 개론, 스튜디오 설계, 아날로그와 디지털 음향장비 그리고 미디, 스피커, 앰프, 멀티미디어와 웹에 이르기까지… 이 책은 방대하고 유용한 내용을 다룬다. 특히 6판에서는 디지털 음향기술과 서라운드 사운드, 마스터링에 관한 신기술을 알기 쉽고 명쾌하게 설명한다. 음향용어 사전을 실은 웹 사이트도 소개한다. 독자들이 아이디어를 공유하고, 조언을 구하고, 언제 어디서나 정보를 찾아볼 수 있는 것도 최신판인 6판의 자랑거리다." ],
        "mms" : [ "991000697409703286" ],
        "contributor" : [ "허버, 데이빗 마일즈$$Q허버, 데이빗 마일즈", "런스타인, 로버트$$Q런스타인, 로버트", "김철웅$$Q김철웅" ],
