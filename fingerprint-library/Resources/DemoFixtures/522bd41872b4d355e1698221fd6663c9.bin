  }, {
    "context" : "L",
    "adaptor" : "Local Search Engine",
    "@id" : "https://ap01.alma.exlibrisgroup.com/primaws/rest/pub/pnxs/L/991003751954103286",
    "pnx" : {
      "display" : {
        "source" : [ "Alma" ],
        "type" : [ "book" ],
        "language" : [ "pol" ],
        "title" : [ "Strategia UX : techniki tworzenia innowacyjnych rozwiązań cyfrowych " ],
        "format" : [ "1 online resource (216 pages) : illustrations" ],
        "identifier" : [ "$$CISBN$$V9788328382909;$$CISBN$$V8328382903;$$COCLC$$V(OCoLC)1382357700;$$COCLC$$V(OCoLC-P)1382357700" ],
        "creationdate" : [ "2021" ],
        "creator" : [ "Levy, Jaime, author.$$QLevy, Jaime" ],
        "publisher" : [ "Gliwice : Helion" ],
        "description" : [ "Droga do sukcesu produktu cyfrowego prowadzi przez serce użytkownika. Historia biznesu obfituje w przykłady świetnych pomysłów, które poniosły spektakularną porażkę z powodu zlekceważenia wrażeń użytkownika. Przy opracowywaniu biznesowej strategii rozwoju produktu czy usługi trzeba więc zacząć od zebrania kluczowych informacji o przyszłych użytkownikach, ich potrzebach, preferencjach i przyzwyczajeniach, a także o konkurencyjnych produktach i perspektywach. Okazuje się jednak, że łączenie strategii typowo biznesowych z zasadami projektowania UX jest niełatwym zadaniem. To drugie, zaktualizowane i uzupełnione wydanie praktycznego podręcznika dla przedsiębiorców, projektantów UX i UI, a także menedżerów i strategów produktu. Znalazły się w nim skuteczne narzędzia i techniki strategiczne, które udowodniły swoją przydatność w tworzeniu innowacyjnych produktów cyfrowych. Narzędzia te zostały udostępnione również w formie gotowego przybornika strategii UX. Pokazano tu, w jaki sposób zaplanować i przeprowadzić badania użytkowników, aby wyniki pozwoliły na opracowanie skutecznych strategii produktowych. Całość zawartych w książce materiałów składa się na solidny, przetestowany i skuteczny model praktyk ułatwiających wdrażanie innowacyjnych, udanych produktów cyfrowych." ],
        "mms" : [ "991003751954103286" ],
        "contributor" : [ "Gutowski, Maksymilian, translator.$$QGutowski, Maksymilian" ],
        "edition" : [ "Wydanie II." ],
        "unititle" : [ "Strategia UX. Polish" ],
        "includes" : [ "Levy, Jaime, Strategia UX. Polish$$QLevy, Jaime, Strategia UX. Polish" ],
        "place" : [ "Gliwice :" ],
        "version" : [ "0" ],
        "subject" : [ "User-centered system design", "Human-computer interaction", "User interfaces (Computer systems)", "Web sites -- Design" ]
      },
      "control" : {
