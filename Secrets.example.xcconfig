// Copy as Secrets.xcconfig. Never add provider API keys here.
// automatic: Debug/simulator -> dev; verified TestFlight -> testfligh; App Store -> production.
// automatic Release requires three distinct relay tokens below.
// internal is only for an internal Release build, not a Store/TestFlight archive.
// Archive/install requires Release + automatic; internal is allowed only for local Build/Run.
POBOOK_BUILD_CHANNEL = automatic
POBOOK_RELAY_TOKEN_DEVELOPMENT =
POBOOK_RELAY_TOKEN_TESTFLIGHT =
POBOOK_RELAY_TOKEN_PRODUCTION =
